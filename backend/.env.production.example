APP_NAME="MedAccess Sudan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.medaccesssudan.tech
APP_TIMEZONE=Africa/Khartoum

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medaccess_sudan
DB_USERNAME=medaccess_app
DB_PASSWORD=CHANGE_ME

# The web SPA uses Sanctum session cookies; the mobile app uses Sanctum bearer tokens.
FRONTEND_URL=https://medaccesssudan.tech
FRONTEND_URLS=https://medaccesssudan.tech
SANCTUM_STATEFUL_DOMAINS=medaccesssudan.tech,api.medaccesssudan.tech
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.medaccesssudan.tech
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# Provider approval must remain an administrator decision in production.
MEDACCESS_DEMO_AUTO_VERIFY_DOCTORS=false
FEATURED_DOCTOR_MIN_REVIEWS=3
MEDACCESS_VERIFICATION_MAX_KILOBYTES=8192

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Replace these placeholders with the production mail provider settings.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@medaccesssudan.tech
MAIL_FROM_NAME="${APP_NAME}"

